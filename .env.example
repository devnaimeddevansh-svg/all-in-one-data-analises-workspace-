# NexusOS Environment Variables

Copy this file to `.env` and fill in the values.

## App
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

## Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusos?schema=public

## Redis (for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

## Auth - Google OAuth
# In Google Cloud Console → APIs & Services → Credentials:
# - Authorized JavaScript origins: https://your-production-domain.com
# - Authorized redirect URIs: https://your-production-domain.com/api/auth/callback/google
# - OAuth consent screen: add Privacy Policy URL (https://your-domain.com/privacy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Auth behavior
# Auto-verify emails when Resend is not configured (recommended for dev)
AUTH_AUTO_VERIFY=true
# Set to true in production when email delivery is configured
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

## Email (Resend) - optional for production
RESEND_API_KEY=
EMAIL_FROM=NexusOS <onboarding@yourdomain.com>

## AI - Groq (required)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

## Web Search (Tavily) - optional
TAVILY_API_KEY=

## S3-Compatible Storage
S3_BUCKET=nexusos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

## Stripe (TEST mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_SCALE_PRICE_ID=price_...

## Rate Limiting (optional - Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
