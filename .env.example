# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Database — use a standard postgresql:// URL in production (Neon, Supabase, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusos?schema=public

# Redis (optional — sync fallback when unavailable)
REDIS_URL=redis://localhost:6379

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — Groq
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# S3 (optional for file upload)
S3_BUCKET=nexusos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
